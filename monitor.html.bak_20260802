var LAST=[null,null], VAL={}, SK=null, SD=-1;
function sortBy(k){SD=(SK===k?-SD:-1);SK=k;
  ORDER.sort(function(a,b){var va=(VAL[a]&&VAL[a][k]!=null?VAL[a][k]:-1e9),vb=(VAL[b]&&VAL[b][k]!=null?VAL[b][k]:-1e9);return (va-vb)*SD;});
  document.getElementById('tb').innerHTML=ORDER.map(row).join('');
  upd(LAST[0],LAST[1]);}
function f(x){return x==null?'—':(Math.round(x*100)/100);}
function near(price,arr,above){var c=arr.filter(function(x){return x!=null;}).filter(function(x){return above?x>=price:x<=price;});c.sort(function(a,b){return above?a-b:b-a;});return c.length?c[0]:null;}
function row(c){var d=DB[c];if(!d)return '';
  return '<tr data-c="'+c+'"><td class="l"><span class="tag '+(d.src==="手動"?"m":"a")+'">'+d.src+'</span></td>'
    +'<td class="l"><b>'+c+'</b> '+(d.n||'')+'</td>'
    +'<td class="px" id="px_'+c+'">—</td><td id="ch_'+c+'">—</td><td id="av_'+c+'" class="mut">—</td>'
    +'<td id="poc_'+c+'" class="mut">—</td>'
    +'<td class="mut">'+f(d.gd)+' / '+f(d.gu)+'</td>'
    +'<td id="np_'+c+'">—</td>'
    +'<td class="mut">'+f(d.ah)+' / '+f(d.nh)+' / '+f(d.ph)+'</td>'
    +'<td class="mut">'+f(d.pl)+' / '+f(d.nl)+' / '+f(d.al)+'</td>'
    +'<td id="ns_'+c+'">—</td><td id="st_'+c+'" class="st">—</td></tr>';}
document.getElementById('tb').innerHTML=ORDER.map(row).join('');
// ★點代碼 → 彈出日K棒圖 + 疊撐壓/CDP
function drawK(c,tf){var d=DB[c];if(!d)return;tf=tf||'D';
  var K=(tf==='D'?d.k:(tf==='60'?d.k60:(tf==='15'?d.k15:d.k5)));
  if(!K||!K.length){document.getElementById('kSvg').innerHTML='<div class="mut" style="padding:24px">'+(tf==='D'?'無日K棒資料':(tf+'分K棒尚未產生 —— 請先跑 建監控多週期K.bat 再重產監控頁'))+'</div>';return;}
  var w=904,h=440,padL=66,padR=16,padT=12,padB=8,n=K.length;
  var lv=[d.ah,d.nh,d.m,d.nl,d.al,d.vr,d.vs,d.gu,d.gd].filter(function(x){return x!=null;});
  var lows=K.map(function(x){return x[2];}).concat(lv),his=K.map(function(x){return x[1];}).concat(lv);
  var mn=Math.min.apply(null,lows),mx=Math.max.apply(null,his),rng=(mx-mn)||1;
  function X(i){return padL+(w-padL-padR)*(i+0.5)/n;}function Y(v){return padT+(h-padT-padB)*(1-(v-mn)/rng);}
  var s='<svg width="'+w+'" height="'+h+'" style="background:#0b0f14;border:1px solid #263341;border-radius:8px">';
  for(var g=0;g<5;g++){var pv=mn+rng*g/4,yy=Y(pv);s+='<line x1="'+padL+'" y1="'+yy+'" x2="'+(w-padR)+'" y2="'+yy+'" stroke="#1c2530"/><text x="4" y="'+(yy+3)+'" fill="#8a9bab" font-size="10">'+pv.toFixed(2)+'</text>';}
  var LV=[['#ff5d5d',d.ah,'壓2'],['#ff5d5d',d.nh,'壓1'],['#ffffff',d.m,'參'],['#3ec77a',d.nl,'撐1'],['#3ec77a',d.al,'撐2'],['#f0b429',d.vr,'量壓'],['#e0b060',d.vs,'量撐'],['#e06666',d.gd,'缺壓'],['#5aa87a',d.gu,'缺撐']].filter(function(t){return t[1]!=null;});
  LV.sort(function(a,b){return b[1]-a[1];});   // 依價位由高到低排,再左右交錯 → 相鄰的分兩側,字不重疊
  LV.forEach(function(t,idx){var yy=+Y(t[1]).toFixed(1);s+='<line x1="'+padL+'" y1="'+yy+'" x2="'+(w-padR)+'" y2="'+yy+'" stroke="'+t[0]+'" stroke-width="1" stroke-dasharray="5,3" opacity="0.85"/>';
    var left=(idx%2===0),tx=left?(padL+3):(w-padR-3),anc=left?'start':'end';
    s+='<text x="'+tx+'" y="'+(yy-2)+'" fill="'+t[0]+'" font-size="9" text-anchor="'+anc+'">'+t[2]+' '+t[1]+'</text>';});
  var cw=Math.max(2,(w-padL-padR)/n*0.62);
  for(var i=0;i<n;i++){var o=K[i][0],hi=K[i][1],lo=K[i][2],cl=K[i][3],up=cl>=o,col=up?'#ff5d5d':'#3ec77a',x=X(i);
    s+='<line x1="'+x.toFixed(1)+'" y1="'+Y(hi).toFixed(1)+'" x2="'+x.toFixed(1)+'" y2="'+Y(lo).toFixed(1)+'" stroke="'+col+'" stroke-width="1"/>';
    var yo=Y(o),yc=Y(cl),top=Math.min(yo,yc).toFixed(1),bh=Math.max(Math.abs(yo-yc),1).toFixed(1);
    s+='<rect x="'+(x-cw/2).toFixed(1)+'" y="'+top+'" width="'+cw.toFixed(1)+'" height="'+bh+'" fill="'+col+'"/>';}
  document.getElementById('kSvg').innerHTML=s+'</svg>';}
function openK(c){var d=DB[c];if(!d)return;document.getElementById('kT').innerHTML='<b>'+c+'</b> '+(d.n||'')+' <span class="mut" style="font-size:12px">日K · 疊 日CDP+大量撐壓(盤後看明天)</span>';
  document.querySelectorAll('.ktb').forEach(function(b){b.classList.toggle('on',b.getAttribute('data-tf')==='D');});
  drawK(c,'D');document.getElementById('kov').setAttribute('data-c',c);document.getElementById('kov').style.display='flex';}
document.getElementById('tb').addEventListener('click',function(e){var tr=e.target.closest('tr[data-c]');if(tr)openK(tr.getAttribute('data-c'));});
document.getElementById('kX').onclick=function(){document.getElementById('kov').style.display='none';};
document.getElementById('kov').addEventListener('click',function(e){if(e.target===this)this.style.display='none';});
document.getElementById('ktf').addEventListener('click',function(e){var b=e.target.closest('.ktb');if(!b)return;var tf=b.getAttribute('data-tf');
  document.querySelectorAll('.ktb').forEach(function(x){x.classList.remove('on');});b.classList.add('on');drawK(document.getElementById('kov').getAttribute('data-c'),tf);});
function upd(prices,intra){
  var conn=0;
  ORDER.forEach(function(c){
    var d=DB[c], q=prices&&prices[c]; var tr=document.querySelector('tr[data-c="'+c+'"]');
    var live=!!(q&&q.p!=null); if(live)conn++;
    var p=live?+q.p:d.pc; if(p==null){return;}
    var ch=(live&&q.c!=null?+q.c:(d.chg!=null?d.chg:null)); if(ch!=null&&Math.abs(ch)>10.5)ch=null;
    document.getElementById('px_'+c).textContent=p+(live?'':' 收');
    var che=document.getElementById('ch_'+c); che.textContent=(ch!=null?((ch>0?'+':'')+ch.toFixed(2)):'—'); che.className=(ch>0?'pos':(ch<0?'neg':'mut'));
    // 均價(盤中即時才有)
    var avg=null; if(live&&intra&&intra.avg&&intra.avg[c]){var a=intra.avg[c];for(var i=a.length-1;i>=0;i--){if(a[i]!=null){avg=a[i];break;}}}
    document.getElementById('av_'+c).textContent=(avg!=null?Math.round(avg*100)/100:'—');
    document.getElementById('poc_'+c).innerHTML=(function(){var a=[];if(d.vr!=null)a.push('<span style="color:#ff8a8a">壓'+f(d.vr)+'</span>');if(d.vs!=null)a.push('<span style="color:#7fe0a8">撐'+f(d.vs)+'</span>');return a.length?a.join(' / ')+(d.s6?' 60':''):'—';})();
    var press=[d.ah,d.nh,d.ph,d.vr,d.gd], supp=[d.nl,d.al,d.pl,d.vs,d.gu];
    var nP=near(p,press,true), nS=near(p,supp,false);
    document.getElementById('np_'+c).textContent=(nP!=null?(f(nP)+' ('+((nP-p)/p*100).toFixed(1)+'%)'):'—');
    document.getElementById('ns_'+c).textContent=(nS!=null?(f(nS)+' ('+((p-nS)/p*100).toFixed(1)+'%)'):'—');
    var st='—',cls='st'; tr.className='';
    if(nP!=null&&(nP-p)/p<=0.005){st='撞壓力';cls='st stP';tr.className='hitP';}
    else if(nS!=null&&(p-nS)/p<=0.005){st='撞支撐';cls='st stS';tr.className='hitS';}
    else if(avg!=null){st=(p>=avg?'站均價(偏多)':'均價下(偏弱)');cls='st '+(p>=avg?'stP':'stS');}
    var ste=document.getElementById('st_'+c); ste.textContent=st; ste.className=cls;
    VAL[c]={p:p,ch:(ch==null?-999:ch),av:(avg==null?-1:avg),pocd:(d.vr!=null?(d.vr-p)/p*100:9999),npd:(nP!=null?(nP-p)/p*100:9999),nsd:(nS!=null?(p-nS)/p*100:9999),st:(st==='撞壓力'?2:(st==='撞支撐'?1:0))};
  });
  var s=document.getElementById('stat');
  if(conn>0){s.textContent='🟢 盤中即時 · 對到 '+conn+'/'+ORDER.length+' 檔(每5秒更新)';s.style.background='#12331f';s.style.color='#7fe0a8';}
  else{s.textContent='⚪ 盤後/未連線 · 顯示昨收 vs 壓力支撐(要盤中即時請開 一鍵_即時橋接.bat + XQ族群個股.xlsx)';s.style.background='#1c2530';s.style.color='#9fb0c0';}
}
function tick(){Promise.all([fetch('prices.json').then(function(r){return r.json();}).catch(function(){return null;}),
  fetch('intraday.json').then(function(r){return r.json();}).catch(function(){return null;})]).then(function(a){LAST=a;upd(a[0],a[1]);});}
tick(); setInterval(tick,5000);
</script>